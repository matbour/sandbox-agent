# agentd settings: copy to secrets/config.env (chmod 600). secrets/ is ignored by Git.
# Secrets are separate files in the same directory, not values here:
#   secrets/linear-api-key   Linear personal API key (Settings > Security & access)
#   secrets/github-app.pem   GitHub App private key
#   secrets/setup.sh         optional sandbox setup script (copy deploy/examples/setup.sh)
# Any setting can also be overridden by an environment variable of the same name.

# Issues carrying this label are picked up; the label is removed when the job starts.
TRIGGER_LABEL=agent
# Optional: comma-separated team keys to watch. Empty: all teams.
LINEAR_TEAMS=
POLL_INTERVAL=30s

# GitHub App installed on the target repository only (see docs/decisions.md, D12).
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_REPO=
# Empty: the repository's default branch.
BASE_BRANCH=

# Commit identity (author and committer). Empty: sandbox-agent. Platforms such as Vercel only deploy
# commits whose author is a team member: use the GitHub name and email of the person who reviews.
COMMIT_AUTHOR_NAME=
COMMIT_AUTHOR_EMAIL=

# Sandbox. secrets/setup.sh is used if present; a sibling setup.notes.md is appended to the
# agent's prompt.
CPUS=4-7
SANDBOX_CPUS=4
SANDBOX_MEMORY=6g
# Extra per-sandbox deny rules (comma-separated hosts), on top of the global sbx policy.
DENY_NETWORK=

# Agent. Issues labelled TRIGGER_LABEL run with AGENT_MODEL; issues labelled OPUS_LABEL run with
# OPUS_MODEL. Failed runs suggest retrying with OPUS_LABEL.
AGENT_MODEL=claude-sonnet-5-5
OPUS_LABEL=agent-opus
OPUS_MODEL=claude-opus-5-5
AGENT_MAX_TURNS=150
AGENT_BUDGET_USD=5
AGENT_TIMEOUT=45m

# Patch limits. DENY_PATHS: comma-separated path prefixes (ending with /) or exact paths the patch
# must not touch, for example paths that trigger CI workflows with secrets.
DENY_PATHS=
MAX_FILES=200
MAX_PATCH_BYTES=2000000
