# agentd settings: copy to secrets/config.env (chmod 600). secrets/ is ignored by Git.
# Secrets are separate files in the same directory, not values here:
#   secrets/linear-client-id, secrets/linear-client-secret  Linear OAuth application with client
#                            credentials (comments appear as the application)
#   secrets/github-app.pem   GitHub App private key
#   secrets/setup.sh         optional sandbox setup script (copy deploy/examples/setup.sh)
# Any setting can also be overridden by an environment variable of the same name.

# Issues carrying this label are picked up; the label is removed when the job starts.
TRIGGER_LABEL=agent
# Optional: comma-separated team keys to watch. Empty: all teams.
LINEAR_TEAMS=
POLL_INTERVAL=30s

# GitHub App installed on the target repository only (see docs/decisions.md, D12).
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_REPO=
# Empty: the repository's default branch.
BASE_BRANCH=

# Commit identity (author and committer). Empty: sandbox-agent. Platforms such as Vercel only deploy
# commits whose author is a team member: use the GitHub name and email of the person who reviews.
COMMIT_AUTHOR_NAME=
COMMIT_AUTHOR_EMAIL=

# Sandbox. secrets/setup.sh is used if present; a sibling setup.notes.md is appended to the
# agent's prompt.
# Sandbox provider: sbx (Docker Sandboxes). Others are being added (see internal/sandbox).
SANDBOX_PROVIDER=sbx
CPUS=4-7
SANDBOX_CPUS=4
SANDBOX_MEMORY=6g
# Extra per-sandbox deny rules (comma-separated hosts), on top of the global sbx policy.
DENY_NETWORK=

# Agent. Issues labelled TRIGGER_LABEL run with AGENT_MODEL. MODEL_LABELS maps labels that select a
# model explicitly (label=model, weakest first; with several on one issue, the strongest wins).
# Failed runs suggest RETRY_LABEL.
AGENT_MODEL=claude-sonnet-5-5
MODEL_LABELS=agent-haiku=claude-haiku-5-5,agent-sonnet=claude-sonnet-5-5,agent-opus=claude-opus-5-5,agent-fable=claude-fable-5-2
RETRY_LABEL=agent-opus
AGENT_MAX_TURNS=150
AGENT_BUDGET_USD=5
AGENT_TIMEOUT=45m

# HTTP server (loopback only, exposed through a Cloudflare Tunnel): Linear webhook at
# /webhooks/linear (signed with secrets/linear-webhook-secret), overview at / and /api/jobs.
# Requests through the tunnel to the overview need a Cloudflare Access JWT for ACCESS_AUD.
WEB_ADDR=127.0.0.1:8787
ACCESS_TEAM=
ACCESS_AUD=
# Public URL of the overview, linked from Linear agent sessions (e.g. https://agent.example.com).
OVERVIEW_URL=

# After a push: wait for the pull request's checks, run fix passes while they fail, then mark the
# PR ready for review, or leave it a draft and assign the issue back. IGNORE_CHECKS: checks that do
# not decide readiness (comma-separated, substring match).
CI_TIMEOUT=25m
CI_FIX_ATTEMPTS=2
IGNORE_CHECKS=claude-review

# Patch limits. DENY_PATHS: comma-separated path prefixes (ending with /) or exact paths the patch
# must not touch, for example paths that trigger CI workflows with secrets.
DENY_PATHS=
MAX_FILES=200
MAX_PATCH_BYTES=2000000
