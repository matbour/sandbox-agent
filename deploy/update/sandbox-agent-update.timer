# User unit: ~/.config/systemd/user/sandbox-agent-update.timer (D50, D56). Checks for new binaries
# every minute; when nothing changed, a check is one download of a 41-byte file.
[Unit]
Description=sandbox-agent: check for new binaries every minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
RandomizedDelaySec=10s

[Install]
WantedBy=timers.target
