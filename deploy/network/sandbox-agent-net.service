# System unit, installed by the machine's owner (D44):
#   sudo install -D -m 0755 deploy/network/fc-net.sh /usr/local/libexec/sandbox-agent/fc-net
#   sudo install -D -m 0644 deploy/network/network.env /etc/sandbox-agent/network.env  # then edit
#   sudo install -m 0644 deploy/network/sandbox-agent-net.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now sandbox-agent-net
# Not on the board without the owner's agreement: it changes the firewall next to Docker's.
[Unit]
Description=sandbox-agent: bridge, taps and NAT for Firecracker guests
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/sandbox-agent/network.env
ExecStart=/usr/local/libexec/sandbox-agent/fc-net up
ExecStop=/usr/local/libexec/sandbox-agent/fc-net down

[Install]
WantedBy=multi-user.target
